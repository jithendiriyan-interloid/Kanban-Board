<div class="w-full">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <p class="mt-1 text-sm dark:text-slate-300">Welcome, <%= current_user.first_name %></p>
    </div>
  </div>
  <% flash.each do |type, message| %>
    <% next if message.blank? %>
    <% flash_class = type.to_s == "alert" ? "border-red-200 bg-red-50 text-red-700" : "border-green-200 bg-green-50 text-green-700" %>
  <% end %>
  <div class="grid gap-6 lg:grid-cols-2">
    <% if @show_profile_form %>
      <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-colors dark:border-slate-700 dark:bg-slate-900">
        <h2 class="mb-2 text-xl font-bold dark:text-slate-100"><%= @editing_profile ? "Edit profile" : "Complete your profile" %></h2>
        <%= form_with model: current_user, url: profile_path, method: :patch, class: "w-full" do |f| %>
          <% if current_user.errors.any? %>
            <div class="mb-5 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700 dark:border-red-900/80 dark:bg-red-950/50 dark:text-red-200">
              <ul class="list-disc pl-5">
                <% current_user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="mb-4">
              <%= f.label :first_name, "First name", class: "mb-1 block text-base font-medium dark:text-slate-200" %>
              <%= f.text_field :first_name, autocomplete: "given-name", class: "w-full rounded-sm border border-gray-300 bg-white px-3 py-2 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:placeholder:text-slate-500", placeholder: "First name" %>
            </div>
            <div class="mb-4">
              <%= f.label :last_name, "Last name", class: "mb-1 block text-base font-medium  dark:text-slate-200" %>
              <%= f.text_field :last_name, autocomplete: "family-name", class: "w-full rounded-sm border border-gray-300 bg-white px-3 py-2 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:placeholder:text-slate-500", placeholder: "Last name" %>
            </div>
          </div>
          <div class="mb-4">
            <%= f.label :phone_number, "Phone number", class: "mb-1 block text-base font-medium  dark:text-slate-200" %>
            <%= f.telephone_field :phone_number, autocomplete: "tel", class: "w-full rounded-sm border border-gray-300 bg-white px-3 py-2 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:placeholder:text-slate-500", placeholder: "Phone number" %>
          </div>
          <div class="mb-4">
            <%= f.label :email, "Current email", class: "mb-1 block text-base font-medium  dark:text-slate-200" %>
            <%= f.email_field :email, autocomplete: "email", disabled: true, readonly: true, class: "w-full rounded-sm border border-gray-300 bg-slate-100 px-3 py-2 text-slate-900 placeholder:text-slate-400 focus:outline-none dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100 dark:placeholder:text-slate-500", placeholder: "Current email" %>
          </div>

          <div class="mb-4">
            <%= f.label :alternate_email, "Alternate email", class: "mb-1 block text-base font-medium  dark:text-slate-200" %>
            <%= f.email_field :alternate_email, autocomplete: "email", class: "w-full rounded-sm border border-gray-300 bg-white px-3 py-2 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:placeholder:text-slate-500", placeholder: "Alternate email" %>
          </div>
          <div class="mb-4">
            <%= f.label :avatar, class: "mb-1 block text-base font-medium  dark:text-slate-200" %>
            <%= f.file_field :avatar, accept: "image/png,image/jpeg,image/webp", class: "w-full rounded-sm border border-gray-300 bg-white px-3 py-2 text-slate-900 file:mr-4 file:rounded-sm file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-sm file:font-medium file: hover:file:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:file:bg-slate-700 dark:file:text-slate-100 dark:hover:file:bg-slate-600" %>
          </div>
          <div class="mb-6">
            <%= f.label :address, class: "mb-1 block text-base font-medium  dark:text-slate-200" %>
            <%= f.text_area :address, rows: 4, autocomplete: "street-address", class: "w-full rounded-sm border border-gray-300 bg-white px-3 py-2 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:placeholder:text-slate-500", placeholder: "Address" %>
          </div>
          <div class="flex items-center gap-3">
            <%= f.submit @editing_profile ? "Update information" : "Save information", class: "rounded-md bg-blue-600 px-5 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition duration-200 cursor-pointer" %>
            <%= link_to "Skip this form", skip_profile_path, data: { turbo_method: :post }, class: "rounded-md border border-gray-300 px-5 py-2 text-sm font-semibold transition duration-200 hover:bg-gray-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800" %>
            <% if @editing_profile %>
              <%= link_to "Cancel", root_path, class: "rounded-md border border-gray-300 px-5 py-2 text-sm font-semibold  transition duration-200 hover:bg-gray-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-colors dark:border-slate-700 dark:bg-slate-900">
        <div class="mb-6 flex items-start justify-between gap-4">
          <div>
            <h2 class="mb-2 text-xl font-bold dark:text-slate-100">Profile information</h2>
            <p class="text-sm dark:text-slate-400">You can update these details later from this page.</p>
          </div>
          <%= link_to "Edit", root_path(edit_profile: true), class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition duration-200" %>
        </div>
        <div class="space-y-1 text-sm  dark:text-slate-200">
          <div class="mb-4 flex items-center gap-4">
            <%= image_tag(current_user.avatar.attached? ? current_user.avatar : "default_avatar.jpg", alt: "Profile avatar", class: "h-24 w-24 rounded-full object-cover") %>
            <div class="flex items-center gap-3">
              <%= link_to "Update", root_path(edit_profile: true), class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition duration-200" %>
            </div>
          </div>
          <p><span class="font-semibold ">First name:</span> <%= current_user.first_name.presence || "Not added" %></p>
          <p><span class="font-semibold ">Last name:</span> <%= current_user.last_name.presence || "Not added" %></p>
          <p><span class="font-semibold ">Phone:</span> <%= current_user.phone_number.presence || "Not added" %></p>
          <p><span class="font-semibold ">Alternate email:</span> <%= current_user.alternate_email.presence || "Not added" %></p>
          <p><span class="font-semibold ">Address:</span> <%= current_user.address.presence || "Not added" %></p>
        </div>
      </div>
    <% end %>
    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-colors dark:border-slate-700 dark:bg-slate-900">
      <div class="rounded-md p-4">
        <h3 class="mb-1  text-slate-800 dark:text-slate-200">Delete account</h3>
        <%= button_to "Delete account", delete_profile_path, method: :delete, data: { turbo_confirm: "Are you sure you want to delete your account?" }, class: "rounded-md bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800 cursor-pointer" %>
      </div>
    </div>
  </div>
</div>
