<div class="w-full">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <p class="mt-1 text-sm ">Welcome, <%= current_user.first_name %></p>
    </div>

  </div>

  <% flash.each do |type, message| %>
    <% next if message.blank? %>
    <% flash_class = type.to_s == "alert" ? "border-red-200 bg-red-50 text-red-700" : "border-green-200 bg-green-50 text-green-700" %>

  <% end %>

  <div class="grid gap-6 lg:grid-cols-2">
    <% if @show_profile_form %>
      <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold text-gray-800 mb-2"><%= @editing_profile ? "Edit profile" : "Complete your profile" %></h2>
        <%= form_with model: current_user, url: profile_path, method: :patch, class: "w-full" do |f| %>
          <% if current_user.errors.any? %>
            <div class="mb-5 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700">
              <ul class="list-disc pl-5">
                <% current_user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="mb-4">
              <%= f.label :first_name, "First name", class: "block text-base font-medium mb-1" %>
              <%= f.text_field :first_name, autocomplete: "given-name", class: "w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-blue-500 focus:outline-none", placeholder: "First name" %>
            </div>

            <div class="mb-4">
              <%= f.label :last_name, "Last name", class: "block text-base font-medium mb-1" %>
              <%= f.text_field :last_name, autocomplete: "family-name", class: "w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-blue-500 focus:outline-none", placeholder: "Last name" %>
            </div>
          </div>

          <div class="mb-4">
            <%= f.label :phone_number, "Phone number", class: "block text-base font-medium mb-1" %>
            <%= f.telephone_field :phone_number, autocomplete: "tel", class: "w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-blue-500 focus:outline-none", placeholder: "Phone number" %>
          </div>

          <div class="mb-4">
            <%= f.label :alternate_email, "Alternate email", class: "block text-base font-medium mb-1" %>
            <%= f.email_field :alternate_email, autocomplete: "email", class: "w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-blue-500 focus:outline-none", placeholder: "Alternate email" %>
          </div>

          <div class="mb-4">
            <%= f.label :avatar, class: "block text-base font-medium mb-1" %>
            <%= f.file_field :avatar, accept: "image/png,image/jpeg,image/webp", class: "w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" %>
          </div>

          <div class="mb-6">
            <%= f.label :address, class: "block text-base font-medium mb-1" %>
            <%= f.text_area :address, rows: 4, autocomplete: "street-address", class: "w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-blue-500 focus:outline-none", placeholder: "Address" %>
          </div>

          <div class="flex items-center gap-3">
            <%= f.submit @editing_profile ? "Update information" : "Save information", class: "rounded-md bg-blue-600 px-5 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition duration-200 cursor-pointer" %>
            <%= link_to "Skip this form", skip_profile_path, data: { turbo_method: :post }, class: "rounded-md border border-gray-300 px-5 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 transition duration-200" %>
            <% if @editing_profile %>
              <%= link_to "Cancel", root_path, class: "rounded-md border border-gray-300 px-5 py-2 text-sm font-semibold hover:bg-gray-100 transition duration-200" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
        <div class="mb-6 flex items-start justify-between gap-4">
          <div>
            <h2 class="text-xl font-bold text-gray-800 mb-2">Profile information</h2>
            <p class="text-sm text-gray-500">You can update these details later from this page.</p>
          </div>

          <%= link_to "Edit", root_path(edit_profile: true), class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition duration-200" %>
        </div>

        <div class="space-y-1 text-sm">
          <% if current_user.avatar.attached? %>
            <p class="mb-4"><%= image_tag current_user.avatar, alt: "Profile avatar", class: "h-24 w-24 rounded-full object-cover" %></p>
          <% end %>
          <p><span class="font-semibold ">First name:</span> <%= current_user.first_name.presence || "Not added" %></p>
          <p><span class="font-semibold ">Last name:</span> <%= current_user.last_name.presence || "Not added" %></p>
          <p><span class="font-semibold ">Phone:</span> <%= current_user.phone_number.presence || "Not added" %></p>
          <p><span class="font-semibold ">Alternate email:</span> <%= current_user.alternate_email.presence || "Not added" %></p>
          <p><span class="font-semibold ">Address:</span> <%= current_user.address.presence || "Not added" %></p>
        </div>
      </div>
    <% end %>

    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-bold text-gray-800 mb-2">Account status</h2>
      <div class="rounded-md  p-4">
        <h3 class="font-semibold  mb-1">Delete account</h3>
        <%= button_to "Delete account", delete_profile_path, method: :delete, data: { turbo_confirm: "Are you sure you want to delete your account?" }, class: "rounded-md bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800 cursor-pointer" %>
      </div>
    </div>
  </div>
</div>
