<% if resource.present? && resource.errors.any? %>
  <div id="toast-top-right"
       class="fixed right-5 top-1 z-auto  w-80 max-w-[calc(100vw-2.5rem)] p-4 text-sm border-red-200 bg-red-50 text-red-700 rounded-lg shadow border transition-opacity duration-1000"
       role="alert"
       data-controller="toast"
       data-turbo-temporary>
    <h2 class="font-semibold text-red-800 mb-2">
      <%= I18n.t("errors.messages.not_saved",
                 count: resource.errors.count,
                 resource: resource.class.model_name.human.downcase)
       %>
    </h2>
    <ul class="list-disc space-y-1 pl-5">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
