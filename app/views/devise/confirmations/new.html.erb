<div class="min-h-screen flex items-center justify-center bg-gray-100 px-4 py-10">
  <div class="grid w-full max-w-5xl overflow-hidden bg-white shadow-md rounded-lg lg:grid-cols-2 p-5">
    <div class="p-10">
      <h3 class="text-2xl font-semibold text-gray-800 mb-2">
        Confirm your account
      </h3>
      <p class=" mb-6">
        Enter your email and we'll resend confirmation instructions
      </p>

      <h2 class="text-xl font-bold  mb-4">Resend confirmation</h2>

      <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "w-full" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="mb-6">
          <%= f.label :email, class: "block text-base font-medium mb-1" %>
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
                class: "w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-blue-500 focus:outline-none",
                placeholder: "Email" %>
        </div>

        <div class="mb-6">
          <%= f.submit "Resend confirmation", class: "w-full bg-blue-600 text-white py-2 rounded-md hover:bg-blue-700 transition duration-200 font-semibold cursor-pointer" %>
        </div>
      <% end %>

      <div class="text-center">
        <p class="text-sm mb-2"> or </p>
        <p class="text-sm ">
          Already confirmed? <%= link_to "Log in", new_session_path(resource_name), class: "text-blue-600 font-semibold hover:underline" %>
        </p>
      </div>
    </div>

    <div class="hidden min-h-[520px] bg-blue-50 lg:block">
      <%= image_tag "login_image.svg", alt: "Kanban board workspace", class: "h-full w-full object-cover" %>
    </div>
  </div>
</div>
