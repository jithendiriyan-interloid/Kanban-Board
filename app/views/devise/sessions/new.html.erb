<div class="min-h-screen flex items-center justify-center bg-gray-100 ">
  <div class="grid w-full max-w-5xl overflow-hidden bg-white shadow-md rounded-lg lg:grid-cols-2 p-5">
    <div class="p-10">

      <h3 class="text-2xl font-semibold text-gray-800 mb-2">
        Hello Again!
      </h3>
      <p class="text-gray-500 mb-6">
        Please enter your email and password to log in
      </p>

      <h2 class="text-xl font-bold text-gray-700 mb-4">Log in</h2>

      <% flash.each do |type, message| %>
        <% next if message.blank? %>
        <% flash_class = type.to_s == "alert" ? "border-red-200 bg-red-50 text-red-700" : "border-green-200 bg-green-50 text-green-700" %>
        <div class="mb-5 rounded-md border p-4 text-sm <%= flash_class %>" data-turbo-temporary>
          <p class="font-semibold <%= type.to_s == "alert" ? "text-red-800" : "text-green-800" %>">
            <%= message %>
          </p>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "w-full" }) do |f| %>
        <div class="mb-4">
          <%= f.label :email, class: "block text-sm font-medium text-gray-600 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-blue-500 focus:outline-none", placeholder: "Email" %>
        </div>

        <div class="mb-4">
          <%= f.label :password, class: "block text-sm font-medium text-gray-600 mb-1" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-blue-500 focus:outline-none", placeholder: "Password" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="mb-6 flex w-full items-center gap-4">
            <div class="flex items-center">
              <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
              <%= f.label :remember_me, class: "ml-2 text-sm text-gray-600" %>
            </div>

            <%= link_to "Forgot password?", new_password_path(resource_name),
                  class: "ml-auto text-sm text-blue-600 hover:underline" %>
          </div>
        <% end %>

        <div class="mb-6">
          <%= f.submit "Log in", class: "w-full bg-blue-600 text-white py-2 rounded-md hover:bg-blue-700 transition duration-200 font-semibold cursor-pointer" %>
        </div>
      <% end %>

      <div class="text-center">
        <p class="text-sm text-gray-500 mb-2"> or </p>
        <p class="text-sm text-gray-700">
          Don't have an account? <%= link_to "Sign up", new_registration_path(resource_name), class: "text-blue-600 font-semibold hover:underline" %>
        </p>
      </div>
    </div>

    <div class="hidden min-h-[520px] bg-blue-50 lg:block">
      <%= image_tag "login_image.svg", alt: "Kanban board workspace", class: "h-full w-full object-cover" %>
    </div>
  </div>
</div>
